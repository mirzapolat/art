# Build-time config — baked into the static HTML. Changing any of these
# requires a rebuild (docker compose up -d --build), not just a restart.

# Public origin of the site, for canonical + hreflang links.
SITE_URL=https://mirzapolat.com

# Shown (and linked) on the contact slide.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
